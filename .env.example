# Copy to .env.local and fill in from the Supabase dashboard (Project settings > API).
# With these unset, the site posts to /api/waitlist and the local dev server handles it.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Edge Function secrets ────────────────────────────────────────────────────
# Set with: supabase secrets set KEY=value
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically.
#
# ALLOWED_ORIGIN=https://glowmouth.com
#
# Optional. Leave unset and no confirmation email is sent; signup still works.
# RESEND_API_KEY=re_xxxxxxxx
# WAITLIST_FROM_EMAIL=GlowMouth <hello@glowmouth.com>
