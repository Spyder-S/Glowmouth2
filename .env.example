# ─────────────────────────────────────────────────────────────────────────────
# Nothing here is prefixed VITE_, and that is deliberate.
#
# Vite only exposes VITE_* variables to the browser bundle. Every secret below
# is read by the server function in api/, so none of them ever reach a visitor.
# If you ever add a VITE_ prefix to one of these, you have published it.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────────────────────────
# Dashboard > Project Settings > Data API   (URL)
# Dashboard > Project Settings > API Keys   (service_role, "secret")
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── EmailJS ──────────────────────────────────────────────────────────────────
# Leave these unset and signups still work; no confirmation email is sent.
# Dashboard > Email Services      (service ID)
# Dashboard > Email Templates     (template ID)
# Dashboard > Account > General   (public key, private key)
EMAILJS_SERVICE_ID=service_xxxxxxx
EMAILJS_TEMPLATE_ID=template_xxxxxxx
EMAILJS_PUBLIC_KEY=your-public-key
EMAILJS_PRIVATE_KEY=your-private-key

# ── Optional ─────────────────────────────────────────────────────────────────
# Restrict who may POST to the waitlist. Defaults to * if unset.
# ALLOWED_ORIGIN=https://glowmouth.com

# Point the form somewhere other than /api/waitlist. Rarely needed.
# VITE_WAITLIST_ENDPOINT=/api/waitlist
